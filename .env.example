PORT=3001

# Isi hanya bila ada reverse proxy di depan server ini:
#   1         -> tepat satu proxy (Nginx / Cloudflare Tunnel)
#   loopback  -> Nginx di mesin yang sama
# Kosongkan bila server diakses langsung. Nilai salah = IP klien bisa dipalsukan.
TRUST_PROXY=

# Set true bila situs HANYA diakses lewat HTTPS (menambah upgrade-insecure-requests ke CSP)
HTTPS_ONLY=false

# Ubah ke 127.0.0.1 bila Nginx berada di mesin yang sama
BIND_ADDR=0.0.0.0
